{
  "name": "tree-view",
  "version": "5.2.2",
  "private": true,
  "scripts": {
    "check": "node --check main.js",
    "format": "prettier --write main.js styles.css",
    "build": "esbuild src/plugin.js --bundle --external:obsidian --format=cjs --platform=node --outfile=main.js",
    "dev": "esbuild src/plugin.js --bundle --external:obsidian --format=cjs --platform=node --outfile=main.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "mermaid": "^11.12.2"
  }
}
